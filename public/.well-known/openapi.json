{
  "openapi": "3.0.0",
  "info": {
    "title": "Shihab Portfolio API",
    "version": "1.0.0",
    "description": "API for Mohammad Shihab Hossain's portfolio website"
  },
  "servers": [
    {
      "url": "https://shihab.vercel.app/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/markdown": {
      "get": {
        "summary": "Get page content as markdown",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown content",
            "content": {
              "text/markdown": {}
            }
          }
        }
      }
    }
  }
}
